# MedNavigator-AI backend environment template
# Copy to backend/.env and replace placeholder secrets.

GOOGLE_API_KEY=
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Local model defaults
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_MODEL=gemini-3.5-flash-lite
CHROMA_DATA_PATH=./chroma_data

# Application
APP_NAME=Healthcare Knowledge Navigator
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./healthcare_navigator.db

# ChromaDB
CHROMA_COLLECTION=medical_knowledge

# Optional provider fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional PubMed integration
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# Optional encryption
ENCRYPTION_KEY=

# Tokens and logging
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
AUDIT_LOG_FILE=logs/audit.log

